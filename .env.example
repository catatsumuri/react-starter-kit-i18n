APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
AUTH_PASSWORD_TIMEOUT=900

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SECURITY_AUDIT_RETENTION_DAYS=180
SECURITY_LOG_RETENTION_DAYS=14
SECURITY_DETECTION_ENABLED=false
SECURITY_DETECTION_CACHE_STORE=redis
SECURITY_ALERT_LOG_CHANNEL=security
SECURITY_ALERT_COOLDOWN_MINUTES=60
SECURITY_KNOWN_CLIENT_DAYS=180
SECURITY_GLOBAL_FAILURE_LIMIT=100
SECURITY_GLOBAL_FAILURE_WINDOW=5
SECURITY_NETWORK_FAILURE_LIMIT=25
SECURITY_NETWORK_FAILURE_WINDOW=5
SECURITY_ACCOUNT_FAILURE_LIMIT=10
SECURITY_ACCOUNT_FAILURE_WINDOW=10
SECURITY_NETWORK_ACCOUNT_LIMIT=10
SECURITY_NETWORK_ACCOUNT_WINDOW=10
SECURITY_ACCOUNT_NETWORK_LIMIT=5
SECURITY_ACCOUNT_NETWORK_WINDOW=10
SECURITY_ACCOUNT_CHANGE_LIMIT=3
SECURITY_ACCOUNT_CHANGE_WINDOW=15
SECURITY_NOTIFICATIONS_ENABLED=true
SECURITY_NOTIFICATION_MAIL_ENABLED=true
SECURITY_NOTIFICATION_COOLDOWN_MINUTES=15
SECURITY_NOTIFICATION_MAIL_HOURLY_LIMIT=5

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
